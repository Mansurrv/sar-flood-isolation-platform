# ==========================================
# SECRETS & CREDENTIALS (CRITICAL)
# ==========================================
.env
.env.*
!.env.example
config/.env
config/.env.*
!config/.env.example
*.pem
*.key
*service-account*.json
credentials*.json
client_secret*.json
*.pfx
*.secret
*.token

# ==========================================
# DATA & GEOSPATIAL FILES (Heavy files)
# ==========================================
data/*
!data/.gitkeep
*.tif
*.tiff
*.gpkg
*.shp
*.shx
*.dbf
*.prj

# ==========================================
# PYTHON
# ==========================================
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.coverage
htmlcov/

# ==========================================
# NODE.JS / FRONTEND
# ==========================================
node_modules/
build/
dist/
coverage/
npm-debug.log*

# ==========================================
# IDE & OS
# ==========================================
.vscode/
.idea/
.DS_Store
Thumbs.db
